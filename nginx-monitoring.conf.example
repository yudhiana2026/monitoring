# Salin blok yang relevan ke konfigurasi Nginx publik Anda.
# Nginx container harus terhubung ke network eksternal `monitoring-proxy`.

server {
    listen 443 ssl http2;
    server_name beszel.example.com;

    # Buat dan mount file ini pada container Nginx sebelum mengaktifkan vhost.
    auth_basic "Monitoring";
    auth_basic_user_file /etc/nginx/secrets/monitoring.htpasswd;

    # Sertifikat TLS mengikuti konfigurasi Nginx server yang sudah ada.
    location / {
        proxy_pass http://beszel:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 360s;
    }
}

server {
    listen 443 ssl http2;
    server_name dozzle.example.com;

    # Dozzle tidak memakai autentikasi aplikasi pada konfigurasi ini.
    # Basic Auth/SSO pada reverse proxy wajib dipertahankan.
    auth_basic "Monitoring";
    auth_basic_user_file /etc/nginx/secrets/monitoring.htpasswd;
    location / {
        proxy_pass http://dozzle:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 360s;
    }
}
